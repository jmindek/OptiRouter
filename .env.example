# OpenRouter API key (standard env var)
OPENROUTER_API_KEY=sk-or-v1-...

# System One model API key (for routing decisions)
ROUTER_API_KEY=sk-or-v1-...

# System One decision model (OpenRouter ID)
ROUTER_MODEL=typesafe/jev-1.13

# System One API base
ROUTER_API_BASE=https://openrouter.ai/api/v1

# OpenRouter inventory URL
ROUTER_INVENTORY_URL=https://openrouter.ai/api/v1

# Routing mode: cloud, local, auto
ROUTER_MODE=auto

# Decision model provider: openrouter, ollama, vllm, systemone
#   openrouter  - hosted via OpenRouter (default)
#   ollama      - local Ollama instance
#   vllm        - local vLLM inference server
#   systemone   - local /v1/systemone server (kev, ollaya, jevos)
ROUTER_DECISION_MODEL_PROVIDER=openrouter

# Local oMLX base URL
ROUTER_OMLX_BASE=http://127.0.0.1:8000

# Ollama decision model config
ROUTER_OLLAMA_BASE=http://127.0.0.1:11434
# Leave empty to use the same model as ROUTER_MODEL
ROUTER_OLLAMA_MODEL=

# vLLM decision model config
ROUTER_VLLM_BASE=http://127.0.0.1:8000
# Leave empty to use the same model as ROUTER_MODEL
ROUTER_VLLM_MODEL=

# SystemOne (kev/ollaya/jev) decision model config
ROUTER_SYSTEMONE_BASE=http://127.0.0.1:8000
# Leave empty to use the same model as ROUTER_MODEL
ROUTER_SYSTEMONE_MODEL=

# Minimum discount threshold (0.0-1.0)
ROUTER_MIN_DISCOUNT=0.25

# Minimum decision-model confidence (0.0-1.0) to accept a routing pick.
# Observed range for model selection is ~0.28-0.40; a 0.55 bar abstained on
# almost every request. Below this the router picks the best candidate by
# ROUTER_LOW_CONFIDENCE_CHOICE.
ROUTER_MIN_CONFIDENCE=0.30

# Which feature to pick the best candidate by when confidence < ROUTER_MIN_CONFIDENCE.
# Options: discount, latency, uptime, coding_index, intelligence_index, agentic_index,
#          cost, throughput, context_window, reasoning, composite_score
ROUTER_LOW_CONFIDENCE_CHOICE=discount

# Routing preference handed to the decision model as a tie-breaker.
#   cost    - prefer the cheaper candidate when models are otherwise comparable
#   quality - prefer the strongest candidate for the task
#   none    - no tie-breaker
ROUTER_PREFERENCE=cost

# Minimum context length in tokens (default 128K = 131072)
ROUTER_MIN_CONTEXT_LENGTH=131072

# Endpoint trustworthiness floors for inventory sweep
ROUTER_MIN_ENDPOINT_UPTIME=95.0
ROUTER_MIN_ENDPOINT_REQUESTS=100

# Feature weights for model decision evaluation
# Can be JSON or comma-separated: ROUTER_WEIGHTS="discount=0.3,cost=0.2,throughput=0.2,latency=0.15,uptime=0.15"
ROUTER_WEIGHTS='{"discount": 0.3, "cost": 0.2, "latency": 0.15, "throughput": 0.15, "uptime": 0.1, "coding_index": 0.1, "context_window": 0.0, "reasoning": 0.0, "composite_score": 0.0}'


# Fallback mode: halt, static
ROUTER_FALLBACK_MODE=static

# Static fallback model ID
ROUTER_STATIC_FALLBACK=openrouter/deepseek/deepseek-v3.1

# Cache file path
ROUTER_CACHE_FILE=data/models.json

# Inventory refresh cron (default: 2am UTC)
ROUTER_REFRESH_CRON="0 * * * *"


# Model handoff when selected model falls off discount list:
#   stop       - return 400 with message (user must pick new model)
#   next_best  - auto-switch to best discounted model (default)
#   keep_current - continue with the model even if not discounted
ROUTER_MODEL_HANDOFF=next_best

# Langfuse tracing (optional). Set all three to send traces to Langfuse;
# otherwise traces print to the console. Langfuse v2 has no OTLP endpoint, so
# the router posts spans to its native ingestion API.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# What to record as a trace's input/output in Langfuse.
#   none      - nothing (timing and model only)
#   decision  - the routing decision, no prompt content
#   truncated - a clipped prompt plus the decision (default)
#   full      - the whole prompt
# Prompts are user content, so the default clips them.
ROUTER_TRACE_INPUT=truncated
ROUTER_TRACE_INPUT_CHARS=500

# Record routing detail (chosen model, confidence, reason) as trace output.
ROUTER_TRACE_ROUTING_DETAIL=true
